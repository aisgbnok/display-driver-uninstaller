<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary surfaces -->
    <SolidColorBrush x:Key="App.Surface.Window" Color="#FF12161D" />
    <SolidColorBrush x:Key="App.Surface.Panel" Color="#FF181E27" />
    <SolidColorBrush x:Key="App.Surface.Panel.Hover" Color="#FF202834" />
    <SolidColorBrush x:Key="App.Surface.Panel.Pressed" Color="#FF111720" />
    <SolidColorBrush x:Key="App.Surface.Control" Color="#FF181E27" />
    <SolidColorBrush x:Key="App.Surface.Control.Hover" Color="#FF202834" />
    <SolidColorBrush x:Key="App.Surface.Control.Pressed" Color="#FF111720" />
    <SolidColorBrush x:Key="App.Surface.Log" Color="#FF1B222D" />
    <SolidColorBrush x:Key="App.Surface.Menu" Color="#FF10151D" />
    <SolidColorBrush x:Key="App.Surface.Status" Color="#FF0F141B" />

    <!-- Text -->
    <SolidColorBrush x:Key="App.Text.Primary" Color="#FFF4F7FA" />
    <SolidColorBrush x:Key="App.Text.Muted" Color="#FFB8C3D1" />
    <SolidColorBrush x:Key="App.Text.Warning" Color="#FFFF8F8F" />
    <SolidColorBrush x:Key="App.Text.Error" Color="#FFFF7B72" />
    <SolidColorBrush x:Key="App.Text.Accent" Color="#FF58A6FF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="App.Border" Color="#FF546173" />
    <SolidColorBrush x:Key="App.Control.Border" Color="#FF546173" />

    <!-- Selection -->
    <SolidColorBrush x:Key="App.Selection.Background" Color="#FF394657" />
    <SolidColorBrush x:Key="App.Selection.Text" Color="#FFD8E0EC" />
    <SolidColorBrush x:Key="App.Selection.ListBackground" Color="#FF2A4A72" />

    <!-- Log specific -->
    <SolidColorBrush x:Key="App.Log.Text.Normal" Color="#FFF2F5F7" />
    <SolidColorBrush x:Key="App.Log.Text.Value" Color="#FF7AB8FF" />
    <SolidColorBrush x:Key="App.Log.Text.Warning" Color="#FFFFC857" />
    <SolidColorBrush x:Key="App.Log.Text.Error" Color="#FFFF7B72" />
    <SolidColorBrush x:Key="App.Log.Selection.Background" Color="#FF2D3A4B" />

    <!-- Log Gradients -->
    <LinearGradientBrush x:Key="App.Log.Background.Event" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF1E3150" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.Log.Background.Warning" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF4A3B16" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.Log.Background.Error" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF4A1F24" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>

    <!-- Brand Gradients -->
    <LinearGradientBrush x:Key="App.Brand.Nvidia" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF416900" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.Brand.Intel" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF13233B" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.Brand.Amd" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF32171B" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.Brand.Realtek" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF152235" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.Brand.SoundBlaster" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF211933" Offset="0" />
        <GradientStop Color="#FF12161D" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
