<Window x:Class="Display_Driver_Uninstaller.FrmNotice"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Display Driver Uninstaller"
	Width="388"
	MinWidth="388"
	MinHeight="118"
	MaxHeight="420"
	SizeToContent="Height"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	Icon="/Display%20Driver%20Uninstaller;component/Resources/DDU.ico"
	Background="{DynamicResource App.Surface.Window}"
	Foreground="{DynamicResource App.Text.Primary}">

    <Window.Resources>
    </Window.Resources>

    <Grid Background="{DynamicResource App.Surface.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="16,15,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="32"
					Height="32"
					Margin="0,2,12,0"
					VerticalAlignment="Top"
					CornerRadius="16"
					Background="{DynamicResource App.Text.Accent}"
					BorderBrush="#FFBFD9FF"
					BorderThickness="1">
                <TextBlock Text="i"
						   FontSize="21"
						   FontWeight="Bold"
						   Foreground="White"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   Margin="0,-2,0,0" />
            </Border>

            <ScrollViewer Grid.Column="1"
						  VerticalAlignment="Top"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled"
						  MaxHeight="170"
						  Margin="0,1,0,0">
                <TextBlock x:Name="txtMessage"
						   TextWrapping="Wrap"
						   Foreground="{DynamicResource App.Text.Primary}"
						   FontSize="12"
						   LineHeight="15.5"
						   MaxWidth="308" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
				BorderBrush="{DynamicResource App.Border}"
				BorderThickness="0,1,0,0"
				Background="{DynamicResource App.Surface.Window}">
            <Grid Margin="12,7,12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnYes"
							Content="Yes"
							Width="75"
							Height="23"
							Margin="0,0,8,0"
							Visibility="Collapsed" />
                    <Button x:Name="btnNo"
							Content="No"
							Width="75"
							Height="23"
							Margin="0,0,8,0"
							Visibility="Collapsed" />
                    <Button x:Name="btnCancel"
							Content="Cancel"
							Width="75"
							Height="23"
							Margin="0,0,8,0"
							Visibility="Collapsed" />
                    <Button x:Name="btnOk"
							Content="OK"
							Width="75"
							Height="23"
							Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
